{
    "gerrit.auth.url": "chromium-review.googlesource.com",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
    },
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.rulers": [
        88
    ],
    "files.autoSave": "afterDelay",
    "editor.codeActionsOnSave": {
        "source.organizeImports": true
    },
    "isort.args": [
        "--profile",
        "black"
    ],
    "cSpell.words": [
        "bloonchipper",
        "bringup",
        "brya",
        "Buganizer",
        "chocodile",
        "chromeos",
        "chromiumos",
        "clstr",
        "containerdir",
        "crbug",
        "dartmonkey",
        "dedede",
        "devnum",
        "devnums",
        "devopts",
        "devs",
        "Dogfood",
        "dragonclaw",
        "dragontalon",
        "ecuart",
        "epoll",
        "FAFT",
        "flashrom",
        "fpmcu",
        "ftdii",
        "Googlers",
        "guybrush",
        "hana",
        "hdctool",
        "hdctools",
        "helipilot",
        "hostdir",
        "hwinit",
        "hwtools",
        "icetower",
        "JTAG",
        "lotid",
        "lotids",
        "milliwatts",
        "nirwen",
        "nissa",
        "noautoconfig",
        "nocheck",
        "NORAW",
        "OOBM",
        "oserror",
        "pids",
        "pinout",
        "pluggable",
        "protobufs",
        "protos",
        "pytest",
        "pyusb",
        "reinit",
        "repohooks",
        "rlist",
        "Satlab",
        "serialname",
        "serialnames",
        "servod",
        "servodtool",
        "shuntmv",
        "skyrim",
        "sweetberry",
        "Sysfs",
        "TAST",
        "tbroch",
        "textproto",
        "timestr",
        "Traceback",
        "UART",
        "Unpowered",
        "unshrouded",
        "XDIST",
        "xmlexc",
        "xmlrpclib",
        "zerblebarn"
    ],
    "gitlens.advanced.blame.customArguments": [
        "--ignore-revs-file",
        ".git-blame-ignore-revs"
    ],
}
