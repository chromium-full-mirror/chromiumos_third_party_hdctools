echo "start generate gRPC Files...."

cp servo/protoc-gen-custom_grpc.py servo/protoc-gen-custom_grpc
chmod +x servo/protoc-gen-custom_grpc

python3 servo/grpc.py
echo $(ls -ltr servo/common/proto)

echo "Finish generate gRPC Files"

echo "starting grpc server ...................."
python3 servo/data/grpc_server/grpc_server_setup.py &


start-servod -t "$@"
