set -ex

TESTS=hdctools

if [ -n "${1}" ]; then
   TESTS="${1}"
fi

scripts/build-servod cq

TEST_IMAGE="servod:devtest"
docker build \
    --build-arg=BASE_IMG=servod:devcq \
    -t "${TEST_IMAGE}" -f servo/dockerfiles/Dockerfile.test .

docker run -it -e SERVOD_LIMIT_TEST_DUT=1 \
    --ulimit=nofile=65535:65535 \
    "${TEST_IMAGE}" \
    python3 servo/data/grpc_server/grpc_server_setup.py & \
    pytest -x ${TESTS}
