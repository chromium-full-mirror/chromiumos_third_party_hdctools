<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>ti50.xml</name>
  </include>
  <include>
    <name>x86_ec_common.xml</name>
  </include>
  <include>
    <name>gsc_chassis_open.xml</name>
  </include>
  <include>
    <name>gsc_reset_pch_disable.xml</name>
  </include>

  <!-- ******** Controls ******** -->

  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over CCD</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>cold_reset:on</item>
            <item>ap_flash_select:on</item>
          </item>
          <item key="0">
            <item>ap_flash_select:off</item>
            <item>cold_reset:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>

  <control>
    <name>cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over direct SPI connection</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>cold_reset:on</item>
            <item>servo_spi_programming:on</item>
            <item>spi2_buf_en:on</item>
            <item>spi2_buf_on_flex_en:on</item>
          </item>
          <item key="0">
            <item>spi2_buf_on_flex_en:off</item>
            <item>spi2_buf_en:off</item>
            <item>servo_spi_programming:off</item>
            <item>cold_reset:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>

  <!-- misc controls -->

  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params drv="cros_ec_softrec_power" clobber_ok=""
    shutdown_delay="11.0" boot_to_rec_screen_delay="10.0"
    warm_reset_can_hold_ap="no"/>
  </control>

  <map>
    <name>ec_chip_map</name>
    <doc>Map from EC-reported chip name to flash_ec-recognised chip</doc>
    <params npcx_uut="npcx" it8xxx2="it82102"></params>
  </map>

  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" interface="EC_CONSOLE" drv="simple_ec" uart_cmd="version"
      regex="Chip:\s+\S+\s+(npcx|it82102)\S*\s" group="1" map="ec_chip_map"/>
  </control>

  <control>
    <name>fw_up</name>
    <params clobber_ok="patch" od="PP" map="onoff" init="off"></params>
  </control>

  <control>
    <name>spi2_vref</name>
    <!-- Disable the SPI2_VREF output load switch to avoid pushing power
    into the DUT. -->
    <params clobber_ok="patch" init="off" />
  </control>
  <control>
    <name>dev_mode</name>
    <alias>servo_spi_programming</alias>
    <doc>Controls a mux on DUT that switches between AP or GSC+Servo access to AP SPI flash.</doc>
    <params clobber_ok="patch" od="PP" map="onoff" init="off" />
  </control>

  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <!-- fw_wp_vref and spi2_vref share the same voltage rail on the servo
    device. Disable the SPI2_VREF output load switch to avoid pushing power
    into the DUT. -->
    <params clobber_ok="patch" fw_wp_vref="off" />
  </control>

  <control>
    <name>dut_pd_data_role</name>
    <params clobber_ok="patch" pdc="yes" port_count="1" />
  </control>

  <control>
    <!--  Enable Trulo to use tokenizing in the future. Servod will still
    properly handle non-tokenized output. -->
    <name>uses_cros_ec_tokens</name>
    <doc>CrOS EC logging is tokenized</doc>
    <params drv="echo" value="always" interface="servo"/>
  </control>
</root>
