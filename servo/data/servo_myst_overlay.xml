<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>x86_ec_common.xml</name>
  </include>
  <include>
    <name>ti50.xml</name>
  </include>
  <include>
    <name>gsc_reset_pch_disable.xml</name>
  </include>

  <map>
    <name>ap_spi_mux_map</name>
    <doc></doc>
    <doc>Map for Myst ap_spi_mux_sel control. Picks whether the AP or GSC+Servo should have access to AP SPI flash.</doc>
    <params ap="0" gsc_servo="1" />
  </map>

 <!-- FW flashing config -->
  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over CCD</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>cold_reset:on</item>
            <item>ap_flash_select:on</item>
          </item>
          <item key="0">
            <item>ap_flash_select:off</item>
            <item>cold_reset:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over direct SPI connection</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>cold_reset:on</item>
            <item>ap_spi_mux_sel:gsc_servo</item>
            <item>spi2_vref:pp1800</item>
            <item>spi2_buf_en:on</item>
            <item>spi2_buf_on_flex_en:on</item>
          </item>
	  <item key="0">
            <item>spi2_buf_on_flex_en:off</item>
            <item>spi2_buf_en:off</item>
            <item>spi2_vref:off</item>
            <item>ap_spi_mux_sel:ap</item>
            <item>cold_reset:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>

 <!-- misc controls -->
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <!-- fw_wp_vref and spi2_vref share the same voltage rail on the servo
    device, and the AP SPI Flash is 1.8V, so set fw_wp_vref to
    match. b/143319676 -->
    <params clobber_ok="patch" fw_wp_vref="pp1800"/>
  </control>
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="full" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="npcx_uut"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params clobber_ok="patch" cmd="set" drv="cros_ec_softrec_power"/>
  </control>
  <control>
    <name>dev_mode</name>
    <alias>ap_spi_mux_sel</alias>
    <doc>Controls a mux on Myst that switches between AP or GSC+Servo access to AP SPI flash.</doc>
    <!-- change type to push-pull
    https://issuetracker.google.com/issues/276490145#comment11 -->
    <params clobber_ok="patch" od="PP" map="ap_spi_mux_map" />
  </control>
  <control>
    <name>fw_up</name>
    <params clobber_ok="patch" od="PP" map="onoff" init="off"></params>
  </control>
</root>
