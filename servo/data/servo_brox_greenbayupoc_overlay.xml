<root>
  <include>
    <name>servo_brox_overlay.xml</name>
  </include>
  <!-- Greenbayupoc has a unique keyboard matrix -->
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeECGreenbayupoc" clobber_ok="full"></params>
  </control>

</root>
