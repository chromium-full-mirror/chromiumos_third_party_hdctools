<root>
  <!-- Overwrite the lid_open implementation to GSC controlled -->
  <control>
    <name>lid_open</name>
    <params cmd="get" uart_cmd="gpioget CCD_REC_LID_SWITCH"
    regex="\s+([01])\*?\s+CCD_REC_LID_SWITCH" group="1" interface="GSC_CONSOLE" drv="cr50"
    map="yesno" clobber_ok="" init="yes"></params>
    <params cmd="set" uart_cmd="gpioset CCD_REC_LID_SWITCH"
    interface="GSC_CONSOLE" drv="cr50" input_type="str" choices="^(0|1)$"
    map="yesno" clobber_ok="" init="yes"></params>
  </control>
</root>
