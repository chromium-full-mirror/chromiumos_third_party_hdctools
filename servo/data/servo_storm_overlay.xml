<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <control>
    <name>dev_mode</name>
    <doc>dev_mode GPIO is inverted on storm</doc>
    <params map="onoff_i" clobber_ok=""></params>
  </control>
  <control>
    <name>lid_open</name>
    <doc>fake lid for products without one</doc>
    <params interface="servo" drv="na" clobber_ok=""></params>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params cmd="set" interface="servo" drv="storm_power"
    input_type="str" />
  </control>
  <!-- storm does not have a CrOS EC (thus also does not support
    communication through it).-->
  <control>
    <name>supports_cros_ec_communication</name>
    <params clobber_ok="" value="no"/>
  </control>
</root>
