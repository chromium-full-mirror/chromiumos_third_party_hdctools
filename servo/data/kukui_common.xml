<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <!-- cpu_fw_spi_pp1800.xml was previously included by default in servo_v2 and
       servo_micro configs.  Since this board config lacks its own cpu_fw_spi
       implementation, this include has been added as part of removing it from
       servo configs. -->
  <include>
    <name>cpu_fw_spi_pp1800.xml</name>
  </include>
  <include>
    <name>arm_ec_common.xml</name>
  </include>
  <include>
    <name>cr50.xml</name>
  </include>
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="stm32" />
  </control>
  <control>
    <name>cold_reset</name>
    <doc>cold reset used for warm reset</doc>
    <alias>warm_reset</alias>
    <params clobber_ok="patch"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <!-- b/131856041: Kukui tablets boot only after power button
	 pressed > 1.0s.  -->
    <params clobber_ok="" reset_recovery="0.6" drv="cros_ec_softrec_power"
            warm_reset_can_hold_ap="no" usb_power_restore="yes"
            power_key="press"/>
  </control>
</root>
