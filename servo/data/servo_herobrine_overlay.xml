<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>arm_ec_common.xml</name>
  </include>
  <include>
    <name>cr50.xml</name>
  </include>

  <!-- ******** Controls ******** -->
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="" interface="9" drv="fw_wp_ccd"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params  drv="cros_ec_softrec_power" clobber_ok="" shutdown_delay="4.5"/>
  </control>
  <control>
    <name>pch_disable</name>
    <alias>h1_reset</alias>
    <doc>Force H1 power-on reset</doc>
    <params clobber_ok=""></params>
  </control>
  <!--
    Simple property indicating what model of EC we have.  We use a Nuvoton EC
    and the UART programmer, hence "npcx_uut".
  -->
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="npcx_uut"/>
  </control>
  <control>
    <name>ap_flash_select</name>
    <doc>AP_FLASH_SELECT GPIO pin in H1</doc>
    <params subtype="ap_flash_select" interface="9" drv="cr50"
      map="onoff" init="off" />
  </control>
  <control>
    <name>cpu_fw_spi</name>
    <params clobber_ok=""
      set_value_1="spi2_buf_en:on spi2_buf_on_flex_en:on spi2_vref:off
                   ap_flash_select:on cold_reset:on spi_hold:off"
      set_value_0="spi2_buf_en:off spi2_buf_on_flex_en:off spi2_vref:off
                   ap_flash_select:off cold_reset:off spi_hold:off"
      />
  </control>
</root>
