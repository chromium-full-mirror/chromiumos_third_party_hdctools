<root>
  <include>
    <name>servo_skywalker_overlay.xml</name>
  </include>
  <!-- Skywalker's keyboard matrix is same as Chinchou's -->
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeECChinchou" clobber_ok=''>
    </params>
  </control>
</root>
