<root>
  <include>
    <name>servo_atria_overlay.xml</name>
  </include>
  <!-- The Realtek EC add-in card (UART for flashing).
       This is for the RVP, not form-factor designs. -->
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="full" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="rtk_uart" />
  </control>
</root>
