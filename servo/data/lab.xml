<?xml version="1.0"?>
<root>
  <control>
    <name>lab_init_ccd_keepalive_en</name>
    <doc>If ccd is the main device, enable keepalive.</doc>
    <!-- This should only be used on ccd devices. Set all other drivers to na-->
    <params subtype="ccd_keepalive_en" interface="9" drv="na"
    ccd_cr50_drv="cr50" ccd_gsc_drv="cr50" init="on" map="onoff" clobber_ok=""></params>
  </control>
</root>
