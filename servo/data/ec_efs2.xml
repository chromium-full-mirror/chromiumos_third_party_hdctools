<?xml version="1.0"?>
<root>
  <!--
    On boards with EC EFS2 GSC needs to know when the EC resets, so it
    can reset the EC EFS boot_mode. GSC can't tell when the EC resets if
    if it is reset with the servo EC_RST_L signal. This interferes with
    entering recovery since GSC doesn't know the EC is in RO.

    For now keep the default behavior. Select gsc_ec_reset for cold_reset
    use cold_reset_select, so users can manually switch to gsc_reset if
    they want.

    TODO(mruthven): select gsc_reset for servo_micro and c2d2. select
    gsc_ec_reset for ccd devices.
  -->
  <include>
    <name>select_cold_reset.xml</name>
  </include>
  <control>
    <name>cold_reset_select</name>
    <params init="gsc_ec_reset" clobber_ok=""/>
  </control>
</root>
