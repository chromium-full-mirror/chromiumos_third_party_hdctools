<root>
  <include>
    <name>servo_corsola_krabby_overlay.xml</name>
  </include>
  <!-- Chinchou has a unique keyboard matrix -->
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeECChinchou" clobber_ok="full"></params>
  </control>

</root>
