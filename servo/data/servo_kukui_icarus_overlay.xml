<root>
  <include>
    <name>kukui_common.xml</name>
  </include>
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="it8xxx2"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <!-- b/131856041: Kukui tablets boot only after power button pressed > 1.0s.
         b/293212003: Set ec_reboot_wait_ext_delay to add extra time
                      after 'reboot wait-ext ap-off'
    -->
    <params clobber_ok="" reset_recovery="0.6" drv="cros_ec_softrec_power"
            warm_reset_can_hold_ap="no" usb_power_restore="yes"
            power_key="press" ec_reboot_wait_ext_delay="1.0"/>
  </control>
</root>
