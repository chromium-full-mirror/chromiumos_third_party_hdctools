<root>
  <!-- ******** Includes ******** -->
  <include>
    <name>cr50.xml</name>
  </include>
  <include>
    <name>arm_ec_common.xml</name>
  </include>
  <include>
    <name>dev_mode_to_ap_download_reconf.xml</name>
  </include>
  <!-- ******** Maps ******** -->

  <!-- ******** Controls ******** -->
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params drv="cros_ec_softrec_power" clobber_ok=""
    shutdown_delay="11.0" boot_to_rec_screen_delay="10.0"
    warm_reset_can_hold_ap="yes"/>
  </control>
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="patch" fw_wp_vref="pp1800"/>
  </control>
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="it83xx"/>
  </control>
  <control>
    <name>cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over C2D2</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>warm_reset:on</item>
            <item>spi2_vref:pp1800</item>
          </item>
          <item key="0">
            <item>spi2_vref:off</item>
            <item>warm_reset:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>
</root>
