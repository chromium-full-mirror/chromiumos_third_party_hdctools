<root>
  <!-- warm_reset is moved to pin 39, same as hpd -->
  <control>
    <name>hpd</name>
    <remap>warm_reset</remap>
  </control>
  <!-- overwrite its config as pull-up and reversed polarity -->
  <!-- TODO: can be cleaned up with a single source of control xmls -->
  <control>
    <name>hpd</name>
    <doc>hpd</doc>
    <params clobber_ok="patch" map="onoff_i" />
  </control>
  <!-- Not overwrite the map for warm_reset as it might not be using onoff or onoff_i -->
  <control>
    <name>warm_reset</name>
    <doc>warm_reset</doc>
    <params clobber_ok="" od="PU" init="off" />
  </control>
</root>
