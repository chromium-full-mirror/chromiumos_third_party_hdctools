<root>
  <!-- ******** Includes ******** -->
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>cpu_fw_spi_pp3300.xml</name>
  </include>
  <include>
    <name>x86_ec_common.xml</name>
  </include>
  <include>
    <name>cr50.xml</name>
  </include>
  <include>
    <name>warm_reset_reconf.xml</name>
  </include>
  <include>
    <name>gsc_reset_pch_disable.xml</name>
  </include>
  <include>
    <name>ec_efs2.xml</name>
  </include>
  <!-- ******** Controls ******** -->
  <!-- FW flashing config -->
  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over CCD</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <!-- Wait for EC to finish EFS2 RO->RW sysjump if just reset. -->
            <item>sleep:1</item>
            <!-- Cancel any pending reboots to avoid unexpected behavior. -->
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:reboot cancel</item>
            <item>ec_uart_cmd:apshutdown</item>
            <item>sleep:5</item>
            <item>ec_uart_cmd:gpioset en_pp3300_a 1</item>
            <!-- Disconnect consoles to prevent TT congestion -->
            <item>cpu_ec3po_interp_connect:off</item>
            <item>ec_ec3po_interp_connect:off</item>
            <item>fpmcu_ec3po_interp_connect:off</item>
            <item>gsc_ec3po_interp_connect:off</item>
          </item>
          <item key="0">
            <!-- Reconnect consoles first so GSC command works -->
            <item>cpu_ec3po_interp_connect:on</item>
            <item>ec_ec3po_interp_connect:on</item>
            <item>fpmcu_ec3po_interp_connect:on</item>
            <item>gsc_ec3po_interp_connect:on</item>
            <item>gsc_ecrst_pulse:on</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>ccd_cpu_fw_spi_depends_on_ec_fw</name>
    <doc>Returns "yes" or "no" of whether ccd_cpu_fw_spi control depends on DUT EC firmware cooperation. See https://issuetracker.google.com/269804618 for background. This control is only meaningful when ccd_cpu_fw_spi control exists.</doc>
    <params drv="echo" value="yes" interface="servo" clobber_ok="full"/>
  </control>
  <control>
    <!-- Volteer connects TABLET_MODE_L to the rec_mode signal -->
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params drv="cros_ec_softrec_power" clobber_ok="patch" cmd="set"
    reset_recovery="0.6" shutdown_delay="11.0" warm_reset_can_hold_ap="no"/>
  </control>
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="patch" fw_wp_vref="pp3300"/>
  </control>
  <!-- First boards have gang mode programming enabled over servo, CCD uses
  UART mode -->
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="full" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="npcx_int_spi" chip_for_ccd_cr50="npcx_uut"/>
  </control>
  <!-- Overriding regex since Volteer EC seems to use "," instead of ":" -->
  <control>
    <name>ec_board</name>
    <doc>The board name of the EC image</doc>
    <params clobber_ok="patch" regex="RO[:,]\s+(\S*)_v?[\d.\w\+-]+[\n\r]"/>
  </control>
</root>
