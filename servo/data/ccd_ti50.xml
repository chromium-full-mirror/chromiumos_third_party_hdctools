<?xml version="1.0"?>
<root>
  <include>
    <name>ti50.xml</name>
  </include>
  <include>
    <name>ccd_common.xml</name>
  </include>
  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing CPU firmware over CCD</doc>
    <params interface="servo" drv="ni" input_type="str"
            message="Default setting is unsafe on Ti50. Please define a board-specific override in your overlay." />
  </control>
  <control>
    <name>servo_adcs_enabled</name>
    <params name="EN_I2C_DBG_PWR_L" clobber_ok="patch"></params>
  </control>
  <control>
    <name>raw_fpmcu_uart_pty</name>
    <doc>CCD FPMCU console.</doc>
    <params cmd="get" subtype="pty" interface="6" drv="uart">
    </params>
  </control>
  <!-- EC-3PO console interpreter for FPMCU -->
  <control>
    <name>ec3po_fpmcu_console</name>
    <alias>fpmcu_uart_pty</alias>
    <doc>FPMCU UART console provided via EC-3PO console interpreter.</doc>
    <params cmd="get" subtype="pty" interface="FPMCU_CONSOLE" drv="uart">
    </params>
  </control>
  <control>
    <name>fpmcu_ec3po_interp_connect</name>
    <doc>State indicating if interpreter is listening to the FPMCU UART.</doc>
    <params interface="FPMCU_CONSOLE" drv="ec3po_driver" map="onoff" init="on"
    subtype="interp_connect"></params>
  </control>
  <control>
    <name>fpmcu_loglevel</name>
    <doc>FPMCU console loglevel</doc>
    <params interface="FPMCU_CONSOLE" drv="ec3po_driver" input_type="str"
    subtype="loglevel"></params>
  </control>
  <control>
    <name>fpmcu_uart_raw_debug</name>
    <doc>Turn on per-message-received logs to the FPMCU console messages.</doc>
    <params interface="FPMCU_CONSOLE" drv="ec3po_driver" map="onoff" init="off"
    subtype="raw_debug"></params>
  </control>
  <control>
    <name>fpmcu_uart_timestamp</name>
    <doc>Add timestamps to FPMCU console messages</doc>
    <params interface="FPMCU_CONSOLE" drv="ec3po_driver" map="onoff" init="off"
    subtype="timestamp"></params>
  </control>
</root>
