<?xml version="1.0"?>
<root>
  <include>
    <name>common.xml</name>
  </include>
  <include>
    <name>power_tools.xml</name>
  </include>
  <include>
    <name>servo_adc_enabled_noop.xml</name>
  </include>
  <control>
    <name>raw_sweetberry_console_pty</name>
    <alias>raw_sweetberry_uart_pty</alias>
    <doc>Sweetberry's stm32 console.</doc>
    <params cmd="get" subtype="pty" interface="6" drv="uart">
    </params>
  </control>
  <!-- firmware version introspection controls -->
  <control>
    <name>sweetberry_version</name>
    <alias>servo_fw_version</alias>
    <doc>current fw version</doc>
    <params cmd="get" interface="7" drv="simple_ec" uart_cmd="version"
      regex="RO:\s+(\S*_v?[\d.\w\+-]+)[\n\r]" group="1" formatting="strip"/>
  </control>
  <control>
    <name>sweetberry_latest_stable_version</name>
    <alias>sweetberry_latest_version</alias>
    <doc>servo-firmware available fw version</doc>
    <params interface="servo" drv="servo_updater_reader" board="sweetberry"
      channel="stable"/>
  </control>
  <control>
    <name>sweetberry_firmware_channel</name>
    <doc>which channel the current sweetberry firmware is from</doc>
    <params cmd="get" interface="servo" drv="servo_updater_channel_parser"
      board="sweetberry"/>
  </control>
  <control>
    <name>sweetberry_firmware_uptodate</name>
    <doc>whether sweetberry firmware is to update</doc>
    <params cmd="get" interface="servo" drv="servo_firmware_checker"
      board="sweetberry" map="yesno"/>
    <params cmd="set" interface="servo" drv="servo_firmware_checker"
      board="sweetberry" map="check" init="check"/>
  </control>
  <!-- These controls are overwrites to avoid errors in dut-power.
    It's a short-term fix to avoid harmless error messages that might
    confuse the user.
    TODO(coconutruben): remove these once dut-power is designed to
    handle sweetberry differently i.e. not query it for dut info.
    -->
  <control>
    <name>ec_system_powerstate</name>
    <doc>N/A on sweetberry boards.</doc>
    <params clobber_ok="full" drv="na"></params>
  </control>
  <control>
    <name>ec_board</name>
    <doc>N/A on sweetberry boards.</doc>
    <params clobber_ok="full" drv="na"></params>
  </control>
</root>
