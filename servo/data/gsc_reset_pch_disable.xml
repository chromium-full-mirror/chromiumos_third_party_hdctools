<?xml version="1.0"?>
<root>
  <!--
    The pch_disable pin is connected to GSC_RST_L. It can be used to reset gsc.
  -->
  <control>
    <name>gsc_reset</name>
    <alias>cr50_reset_odl,h1_reset</alias>
    <doc>Force gsc power-on reset</doc>
    <params interface="servo" drv="macro" map="onoff">
      <content>
        <item key="get_controls">
          <item>pch_disable</item>
        </item>
        <item key="macro_map">
          <item key="0">
            <item>pch_disable:off</item>
          </item>
          <item key="1">
            <item>pch_disable:on</item>
          </item>
        </item>
      </content>
    </params>
  </control>
</root>
