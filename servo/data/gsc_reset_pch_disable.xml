<?xml version="1.0"?>
<root>
  <!--
    The pch_disable pin is connected to GSC_RST_L. It can be used to reset gsc.
  -->
  <control>
    <name>pch_disable</name>
    <alias>gsc_reset,cr50_reset_odl,h1_reset</alias>
    <doc>Force gsc power-on reset</doc>
    <params clobber_ok="patch"></params>
  </control>
</root>
