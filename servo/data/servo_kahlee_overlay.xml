<root>
  <!-- ******** Includes ******** -->
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <!-- cpu_fw_spi_pp1800.xml was previously included by default in servo_v2 and
       servo_micro configs.  Since this board config lacks its own cpu_fw_spi
       implementation, this include has been added as part of removing it from
       servo configs. -->
  <include>
    <name>cpu_fw_spi_pp1800.xml</name>
  </include>
  <include>
    <name>x86_ec_common.xml</name>
  </include>
  <!-- ******** Controls ******** -->
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="patch" fw_wp_vref="pp1800"/>
  </control>
</root>
