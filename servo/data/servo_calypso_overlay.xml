<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>arm_ec_common.xml</name>
  </include>
  <include>
    <name>ti50.xml</name>
  </include>
  <include>
    <name>ec_efs2.xml</name>
  </include>
  <include>
    <name>gsc_chassis_open.xml</name>
  </include>
  <include>
    <name>gsc_lid_open.xml</name>
  </include>
  <include>
    <name>gsc_reset_pch_disable.xml</name>
  </include>
    <!-- ******** Controls ******** -->
  <control>
    <name>reinit_dut_usb3_en</name>
    <params clobber_ok="patch" init="enabled"/>
  </control>
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="full" interface="GSC_CONSOLE" drv="fw_wp_ccd" input_type="str"
    init="force_off"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params  drv="cros_ec_softrec_power" clobber_ok="" shutdown_delay="4.5"
    apreset_ec_commands="apreset"/>
  </control>
  <!--
    Simple property indicating what model of EC we have.  We use a Nuvoton EC
    and the UART programmer, hence "npcx_uut".
  -->
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="npcx_uut"/>
  </control>
  <!--
    Use the power sequence to emulate the legacy servo warm_reset pin.
    Send the power sequence command to the EC UART.
  -->
  <control>
    <name>warm_reset</name>
    <doc>warm_reset</doc>
    <params subtype="warm_reset" interface="EC_CONSOLE" drv="ec"
    map="onoff_i" clobber_ok=""></params>
  </control>
  <!--
     TODO: check if this is still valid for bluey
  -->
  <control>
    <name>ap_flash_select</name>
    <doc>AP_FLASH_SELECT GPIO pin in H1</doc>
    <params subtype="ap_flash_select" interface="GSC_CONSOLE" drv="cr50"
      map="onoff" init="off" clobber_ok=""/>
  </control>
  <control>
    <name>cpu_fw_spi</name>
    <!--
      TODO: b/288374042: Clean up might be required for bluey
    -->
    <alias>ccd_cpu_fw_spi</alias>
    <!--
      The order does matter. The device has to be put in reset with cr50 idle
      set to active before any other configuration, so cr50 settings won't get
      cleared by a deep sleep reset.
    -->
    <params clobber_ok="full" interface="servo" drv="macro" map="onoff"
      set_value_1="cold_reset:on sleep:2 gsc_idle_level:active spi2_buf_en:on
                   spi2_buf_on_flex_en:on spi2_vref:off ap_flash_select:on
                   spi_hold:off dev_mode:on"
      set_value_0="spi2_buf_en:off spi2_buf_on_flex_en:off spi2_vref:off
                   ap_flash_select:off cold_reset:off spi_hold:off dev_mode:off"
      />
  </control>
  <control>
    <name>ec_boot_mode</name>
    <params clobber_ok="patch" od="PP" map="onoff_i"></params>
  </control>

  <control>
    <name>dev_mode</name>
    <params clobber_ok="patch" od="PP" map="onoff"></params>
  </control>

  <control>
    <name>servo_pre_boot_settings</name>
    <doc>Enable any special settings for servo device that need to happen before
    full servod start.</doc>
    <params clobber_ok="full" drv="macro" interface="servo" input_type="str"
    choices="^(execute_expect_reboot)$">
      <content>
        <item key="macro_map">
          <item key="execute_expect_reboot">
            <item>servo_suzyq_mode_at_poweron:on</item>
            <!-- Below should be always last command in the sequence -->
            <item>servo_uart_cmd:reboot</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>dut_pd_data_role</name>
    <doc>Bluey does not have any PD ports, so this control is disabled.</doc>
    <params clobber_ok='' port_count="0"/>
  </control>
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeMatrix30" clobber_ok="full"></params>
  </control>
  <control>
    <name>uart_gsc_tx_fpmcu_rx</name>
    <doc>UART_GSC_TX_FPMCU_RX GPIO state queryable from GSC console</doc>
    <params interface="GSC_CONSOLE" drv="ec3po_gpio" name="UART_GSC_TX_FPMCU_RX"
    subtype="single" map="onoff"/>
  </control>
  <control>
    <name>uart_fpmcu_tx_gsc_rx</name>
    <doc>UART_FPMCU_TX_GSC_RX GPIO state queryable from GSC console</doc>
    <params interface="GSC_CONSOLE" drv="ec3po_gpio" name="UART_FPMCU_TX_GSC_RX"
    subtype="single" map="onoff"/>
  </control>
</root>
