  <control>
    <name>ppdut5_ma</name>
    <alias>vbus_current</alias>
    <params clobber_ok="patch"></params>
  </control>
  <control>
    <name>ppdut5_mw</name>
    <alias>vbus_power</alias>
    <params clobber_ok="patch"></params>
