<root>
  <include>
    <name>servo_skywalker_overlay.xml</name>
  </include>
  <!-- sidious has matrix v30 -->
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeMatrix30" clobber_ok=''>
    </params>
  </control>
  <!-- Increase short_press duration from 0.2 to 1.2. -->
  <map>
    <name>keypress_duration</name>
    <doc>short hand configs for keypress durations</doc>
    <params tab="0.1" short_press="1.2" press="1.2" long_press="8.5"/>
  </map>
</root>
