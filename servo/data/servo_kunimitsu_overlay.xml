<root>
  <include>
    <name>servo_glados_overlay.xml</name>
  </include>
  <!-- override servo_glados_overlay.xml cpu_fw_spi implementation -->
  <control>
    <name>cpu_fw_spi</name>
    <params clobber_ok="full" interface="servo" drv="macro" map="onoff">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>spi2_buf_en:on</item>
            <item>spi2_buf_on_flex_en:on</item>
            <item>ap_flash_select:on</item>
            <item>cold_reset:on</item>
            <item>spi2_vref:pp3300</item>
            <item>spi_hold:off</item>
          </item>
          <item key="0">
            <item>spi2_buf_en:off</item>
            <item>spi2_buf_on_flex_en:off</item>
            <item>spi2_vref:off</item>
            <item>ap_flash_select:off</item>
            <item>cold_reset:off</item>
            <item>spi_hold:off</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>dev_mode</name>
    <alias>usbpd_boot_mode</alias>
    <params clobber_ok="" od="PP" map="onoff"></params>
  </control>
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params clobber_ok="patch" fw_wp_vref="pp3300"/>
  </control>
</root>
