<root>
  <!-- ******** Controls ******** -->
  <control>
    <name>ec_watchdog</name>
    <doc>Disable RTK EC watchdog</doc>
    <params cmd="get" interface="EC_CONSOLE" drv="na"></params>
    <params cmd="set" interface="servo" drv="macro" input_type="str">
      <content>
        <item key="macro_map">
          <item key="off">
            <!-- [RTK EC] disable watchdog b/502343064, b/559869950 -->
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:wdt disable watchdog@4000c000</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>ccd_wdt_cold_reset</name>
    <doc>Disable RTK EC watchdog before asserting GSC cold reset.</doc>
    <params interface="servo" drv="macro" map="onoff">
      <content>
        <item key="get_controls">
          <item>gsc_cold_reset</item>
        </item>
        <item key="macro_map">
          <item key="0">
            <item>gsc_cold_reset:off</item>
          </item>
          <item key="1">
            <!-- [RTK EC] disable watchdog b/502343064, b/559869950 -->
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:wdt disable watchdog@4000c000</item>
            <item>gsc_cold_reset:on</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>gsc_locked_cold_reset</name>
    <doc>Disable RTK EC watchdog, pulse gsc ecrst, and assert flex cold_reset.</doc>
    <params interface="servo" drv="macro" map="onoff" clobber_ok="full">
      <content>
        <item key="get_controls">
          <item>default_cold_reset</item>
        </item>
        <item key="macro_map">
          <item key="0">
            <item>default_cold_reset:off</item>
          </item>
          <item key="1">
            <!-- [RTK EC] disable watchdog b/502343064, b/559869950 -->
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:wdt disable watchdog@4000c000</item>
            <item>default_cold_reset:on</item>
            <item>gsc_ecrst_pulse:on</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>cold_reset_select</name>
    <params servo_init="gsc_locked_cold_reset" c2d2_init="gsc_reset"
    ccd_init="ccd_wdt_cold_reset" init="servo_specific" clobber_ok="patch"/>
  </control>
  <control>
    <name>power_state</name>
    <params clobber_ok="patch"
    pre_ec_reset_cmd="wdt disable watchdog@4000c000"/>
  </control>
  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over CCD</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <!-- [RTK EC] disable watchdog b/502343064 -->
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:wdt disable watchdog@4000c000</item>
            <!-- Reset the EC; see b/375444551 comment #50 -->
            <item>gsc_uart_regexp:None</item>
            <item>gsc_ec_reset:on</item>
            <item>gsc_uart_cmd:gpioset AP_FLASH_SELECT 1</item>
            <!-- Sleep to ensure the SoC rails get chance to discharge enough. -->
            <item>sleep:1</item>
          </item>
          <item key="0">
            <item>gsc_ec_reset:off</item>
            <item>gsc_uart_cmd:gpioset AP_FLASH_SELECT 0</item>
            <!--Additional reset pulse as kick start to boot DUT -->
            <item>sleep:2</item>
            <item>gsc_ecrst_pulse:on</item>
          </item>
        </item>
      </content>
    </params>
  </control>
</root>
