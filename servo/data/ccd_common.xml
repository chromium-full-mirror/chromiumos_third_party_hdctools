<?xml version="1.0"?>
<root>
  <include>
    <name>common.xml</name>
  </include>
  <include>
    <name>keyboard.xml</name>
  </include>
  <include>
    <name>uart_common.xml</name>
  </include>
  <include>
    <name>select_cold_reset.xml</name>
  </include>
  <!-- UART and CONSOLE settings -->
  <control>
    <name>raw_ec_uart_pty</name>
    <doc>CCD EC_PD console.</doc>
    <params cmd="get" subtype="pty" interface="7" drv="uart">
    </params>
  </control>
  <control>
    <name>raw_cpu_uart_pty</name>
    <doc>CCD AP console.</doc>
    <params cmd="get" subtype="pty" interface="RAW_AP_CONSOLE" drv="uart">
    </params>
  </control>
  <control>
    <name>ec_uart_bitbang_en</name>
    <doc>Enable bit banging for the EC UART.</doc>
    <params subtype="ec_uart_bitbang_en" interface="GSC_CONSOLE" drv="cr50"
    map="onoff" init="off"></params>
  </control>
  <control>
    <name>ccd_ec_uart_parity</name>
    <alias>ec_uart_parity</alias>
    <doc>Parity setting for the EC UART console forwarded over
    CCD.</doc>
    <params subtype="ccd_ec_uart_parity" interface="GSC_CONSOLE" drv="cr50"
    input_type="str"></params>
  </control>
  <control>
    <name>ccd_ec_uart_baudrate</name>
    <alias>ec_uart_baudrate</alias>
    <doc>Baud rate for the EC UART console forwarded over CCD.</doc>
    <params subtype="ccd_ec_uart_baudrate" interface="GSC_CONSOLE" drv="cr50"
    input_type="str"></params>
  </control>
  <control>
    <name>usbpd_uart_routing</name>
    <doc>enable pd uart routing</doc>
    <params clobber_ok="patch" interface="servo" drv="na"
    init="not_applicable"></params>
  </control>
  <control>
    <name>chassis_open</name>
    <params clobber_ok="full" interface="servo" drv="na"
    init="not_applicable"></params>
  </control>
  <!-- Controls overwritten by Cr50 -->
  <control>
    <name>gsc_cold_reset</name>
    <alias>default_cold_reset</alias>
    <params clobber_ok="patch"></params>
  </control>
  <control>
    <name>watchdog_ccd_connected</name>
    <doc>Returns yes if ccd is connected</doc>
    <params cmd="get" subtype="ccd_state" interface="servo" drv="servo_watchdog"
    map="yesno"></params>
  </control>
  <control>
    <name>warm_reset</name>
    <doc>warm_reset (active low)</doc>
    <params cmd="get" uart_cmd="sysrst"
    regex="SYS_RST_L is (asserted|deasserted)" group="1"
    interface="GSC_CONSOLE" drv="cr50" map="asserted_re"></params>
    <params cmd="set" subtype="warm_reset" interface="GSC_CONSOLE" drv="cr50"
    map="onoff_i"></params>
  </control>
  <control>
    <name>pwr_button</name>
    <doc>Power button GPIO</doc>
    <params cmd="get" uart_cmd="powerbtn"
    regex="powerbtn: (forced press|pressed|released)" group="1"
    interface="GSC_CONSOLE" drv="cr50" map="press_re"></params>
    <params cmd="set" subtype="pwr_button" interface="GSC_CONSOLE" drv="cr50"
    map="press"></params>
  </control>
  <control>
    <name>lid_open</name>
    <doc>Emulated lid switch on ec</doc>
    <params cmd="get" uart_cmd="lidstate" regex="lid state: (open|closed)"
    group="1" retries="3" formatting="map_open" interface="EC_CONSOLE"
    drv="simple_ec" map="yesno"></params>
    <params cmd="set" subtype="lid_open" interface="EC_CONSOLE"
    drv="ec" map="yesno"></params>
  </control>
  <control>
    <name>ccd_keepalive_en</name>
    <doc>Enable/disable keepalive on CCD</doc>
    <params clobber_ok="patch" init="on"></params>
  </control>
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <params interface="GSC_CONSOLE" drv="fw_wp_ccd" input_type="str"
    init="force_off" gsc_only="yes" clobber_ok="full" />
  </control>
  <!-- cr50 UART Buffers & VREF Controls -->
  <control>
    <name>jtag_buf_on_flex_en</name>
    <alias>uart4_on_flex_en,cr50_uart_on_flex_en,gsc_uart_on_flex_en,usbpd_uart_on_flex_en</alias>
    <doc>Override control not needed for ccd.</doc>
    <params interface="servo" drv="na" input_type="str"
    init="not_applicable" clobber_ok="patch"></params>
  </control>
  <control>
    <name>jtag_vref_sel0</name>
    <alias>jtag_vref_sel1,fw_wp_vref</alias>
    <params interface="servo" drv="na" input_type="str"
    init="not_applicable" clobber_ok="patch"></params>
  </control>
  <control>
    <name>ccd_ec_boot_mode_uut</name>
    <alias>ec_boot_mode_uut</alias>
    <doc>UUT boot mode GPIO.</doc>
    <params subtype="uut_boot_mode" interface="GSC_CONSOLE" drv="cr50"
    map="onoff_i" init="off" />
  </control>
  <control>
    <name>ccd_ec_boot_mode_bitbang</name>
    <alias>ec_boot_mode,fw_up</alias>
    <doc>EC boot mode GPIO.</doc>
    <params subtype="ec_boot_mode" interface="GSC_CONSOLE" drv="cr50"
    map="onoff" init="off" />
  </control>
  <control>
    <name>gsc_testlab</name>
    <alias>cr50_testlab</alias>
    <doc>GSC testlab state</doc>
    <params clobber_ok="patch" init="open"></params>
  </control>
  <control>
    <name>servo_class</name>
    <doc>servo type (flex or ccd)</doc>
    <params drv="echo" value="ccd" interface="servo" clobber_ok="full"/>
  </control>
  <control>
    <name>servo_adcs_enabled</name>
    <doc>Configure the servod device to read ADCs.</doc>
    <params interface="GSC_CONSOLE" drv="ec3po_gpio"
    subtype="single" map="onoff_i" clobber_ok="full"></params>
  </control>
  <!-- TODO(b/418796156): remove futility_gbb_flags when we have a replacement. -->
  <control>
    <name>futility_gbb_flags</name>
    <doc>get GBB flags using futilty over CCD</doc>
    <params subtype="ccd_flags" drv="futility_gbb" interface="servo"
    input_type="str"></params>
  </control>
</root>
