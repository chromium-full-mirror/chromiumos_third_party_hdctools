<root>
  <include>
    <name>kukui_common.xml</name>
  </include>
  <include>
    <name>detachable.xml</name>
  </include>
  <include>
    <name>dev_mode_to_ap_download_reconf.xml</name>
  </include>
  <!-- The keyboard on detachables is the external USB KB. -->
  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params handler_type="usb" clobber_ok=""></params>
  </control>
  <!-- lid open has to go through the EC always on kukui with stm EC
       irrespective of servo type. -->
  <control>
    <name>lid_open</name>
    <doc>Emulated lid switch on ec</doc>
    <params cmd="get" uart_cmd="lidstate" regex="lid state: (open|closed)"
    group="1" retries="3" formatting="map_open" interface="EC_CONSOLE"
    drv="simple_ec" map="yesno" clobber_ok=""></params>
    <params cmd="set" subtype="lid_open" interface="EC_CONSOLE"
    drv="ec" map="yesno" clobber_ok=""></params>
  </control>
</root>
