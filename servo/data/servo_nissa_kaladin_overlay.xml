<root>
  <include>
    <name>servo_nissa_trulo_overlay.xml</name>
  </include>
  <include>
    <name>pdc_ccd_keepalive.xml</name>
  </include>

  <control>
    <name>init_keyboard</name>
    <doc>initialize keyboard handler</doc>
    <params  map="onoff" init="on" drv="kb_handler_init" interface="servo"
      subtype="init_default_keyboard" handler_type="ChromeMatrix30" clobber_ok="full"></params>
  </control>
  <control>
    <name>lid_open</name>
    <doc>Emulated lid switch on ec</doc>
    <params clobber_ok="full" cmd="get" uart_cmd="lidstate" regex="lid state: (open|closed)"
    group="1" retries="3" formatting="map_open" interface="EC_CONSOLE"
    drv="simple_ec" map="yesno"></params>
    <params clobber_ok="full" cmd="set" subtype="lid_open" interface="EC_CONSOLE"
    drv="ec" map="yesno"></params>
  </control>
  <map>
    <name>ec_chip_map</name>
    <doc>Map from EC-reported chip name to flash_ec-recognised chip</doc>
    <params npcx_uut="npcx" ite_uart="it82102"></params>
  </map>
</root>
