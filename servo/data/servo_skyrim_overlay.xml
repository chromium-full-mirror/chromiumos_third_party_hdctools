<root>
  <include>
    <name>servoflex_v2_r0_p50.xml</name>
  </include>
  <include>
    <name>x86_ec_common.xml</name>
  </include>
  <include>
    <name>ti50.xml</name>
  </include>

  <!-- warm_reset is on pin 39, reconfigure -->
  <include>
    <name>warm_reset_reconf.xml</name>
  </include>

 <!-- FW flashing config -->
  <control>
    <name>ccd_cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over CCD</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:reboot cancel</item>
            <item>ec_uart_cmd:apshutdown</item>
            <item>sleep:5</item>
          </item>
          <item key="0">
            <item>power_state:reset</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>ccd_cpu_fw_spi_depends_on_ec_fw</name>
    <doc>Returns "yes" or "no" of whether ccd_cpu_fw_spi control depends on DUT EC firmware cooperation. See https://issuetracker.google.com/269804618 for background. This control is only meaningful when ccd_cpu_fw_spi control exists.</doc>
    <params drv="echo" value="yes" interface="servo" clobber_ok="full"/>
  </control>
  <control>
    <name>cpu_fw_spi</name>
    <doc>Enable SPI mode for flashing AP firmware over C2D2</doc>
    <params drv="macro" interface="servo" map="onoff" clobber_ok="full">
      <content>
        <item key="macro_map">
          <item key="1">
            <item>ec_uart_regexp:None</item>
            <item>ec_uart_cmd:reboot cancel</item>
            <item>ec_uart_cmd:apshutdown</item>
            <item>sleep:5</item>
            <item>ap_flash_select:on</item>
            <item>spi2_vref:pp1800</item>
          </item>
          <item key="0">
            <item>spi2_vref:off</item>
            <item>ap_flash_select:off</item>
            <item>power_state:reset</item>
          </item>
        </item>
      </content>
    </params>
  </control>
  <control>
    <name>cpu_fw_spi_depends_on_ec_fw</name>
    <doc>Returns "yes" or "no" of whether cpu_fw_spi control depends on DUT EC firmware cooperation. See https://issuetracker.google.com/269804618 for background. This control is only meaningful when cpu_fw_spi control exists.</doc>
    <params drv="echo" value="yes" interface="servo" clobber_ok="full"/>
  </control>

 <!-- misc controls -->
  <control>
    <name>fw_wp_state</name>
    <doc>Used to turn fw wp off and on</doc>
    <!-- fw_wp_vref and spi2_vref share the same voltage rail on the servo
    device, and the AP SPI Flash is 1.8V, so set fw_wp_vref to
    match. b/143319676 -->
    <params clobber_ok="patch" fw_wp_vref="pp1800"/>
  </control>
  <control>
    <name>ec_chip</name>
    <doc>EC chip name (read-only)</doc>
    <params clobber_ok="" cmd="get" subtype="chip" interface="servo"
    drv="cros_chip" chip="npcx_uut"/>
  </control>
  <control>
    <name>power_state</name>
    <doc>Used to turn the DUT off and on</doc>
    <params clobber_ok="" cmd="set" drv="cros_ec_softrec_power"/>
  </control>
</root>
